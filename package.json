{
  "name": "mqtt-telemetry",
  "version": "0.1.0",
  "private": true,
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build && node scripts/check-dist.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run src",
    "test:browser": "playwright test --grep-invert @diagnostic",
    "test:browser:diagnostic": "playwright test --grep @diagnostic --workers=1"
  },
  "dependencies": {
    "mqtt": "^5.15.2",
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.3.1",
    "typescript": "^6.0.0",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
